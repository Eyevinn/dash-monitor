{
  "name": "@eyevinn/dash-monitor",
  "version": "1.0.0",
  "description": "Service to monitor one or more DASH/MPEG-DASH stream(s) for errors and inconsistencies",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dash-monitor": "cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/cli.ts",
    "dev": "ts-node src/cli.ts",
    "test": "npm run build && node test/basic.test.js",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "dash",
    "mpeg-dash",
    "mpd",
    "streaming",
    "monitor",
    "validator",
    "prometheus",
    "metrics"
  ],
  "author": "Eyevinn Technology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eyevinn/dash-monitor.git"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "fastify": "^5.2.1",
    "mpd-parser": "^1.3.1",
    "node-fetch": "^2.7.0",
    "node-getopt": "^0.3.2",
    "short-uuid": "^4.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jasmine": "^5.1.0",
    "@types/node": "^20.14.0",
    "@types/node-fetch": "^2.6.13",
    "@types/node-getopt": "^0.2.35",
    "@types/uuid": "^9.0.8",
    "jasmine": "^5.1.0",
    "jasmine-ts": "^0.4.0",
    "nock": "^13.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
