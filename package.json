{
  "name": "@eyevinn/dash-monitor",
  "version": "1.0.1",
  "description": "Service to monitor one or more DASH/MPEG-DASH stream(s) for errors and inconsistencies",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dash-monitor": "cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/cli.ts",
    "dev": "ts-node src/cli.ts",
    "test": "npm run build && node test/basic-monitor.test.js",
    "test:all": "npm run build && node test/basic-monitor.test.js && node test/error-handling.test.js && node test/validation.test.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "dash",
    "mpeg-dash",
    "mpd",
    "streaming",
    "monitor",
    "validator",
    "prometheus",
    "metrics"
  ],
  "author": "Eyevinn Technology",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eyevinn/dash-monitor.git"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "fastify": "^5.2.1",
    "mpd-parser": "^1.3.1",
    "node-fetch": "^2.7.0",
    "node-getopt": "^0.3.2",
    "short-uuid": "^4.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jasmine": "^5.1.0",
    "@types/node": "^24.0.0",
    "@types/node-fetch": "^2.6.13",
    "@types/node-getopt": "^0.2.35",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "jasmine": "^5.1.0",
    "jasmine-ts": "^0.4.0",
    "nock": "^13.5.4",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  }
}
